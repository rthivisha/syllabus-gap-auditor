# Neon PostgreSQL
DATABASE_URL=postgresql://user:password@ep-host.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_POOLED=postgresql://user:password@ep-host-pooler.region.aws.neon.tech/neondb?sslmode=require

# Pinecone Serverless (768d)
PINECONE_API_KEY=pcsk_your_key_here
PINECONE_INDEX_NAME=syllabus-gap-audit-vec


# LLM & Whisper Providers
GEMINI_API_KEY=AIza_your_key_here
GROQ_API_KEY=gsk_your_key_here

# Optional: Cloudflare AI Gateway
CF_ACCOUNT_ID=
CF_GATEWAY_ID=
CF_AIG_TOKEN=

# Optional: LangSmith Observability
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_your_key_here
LANGCHAIN_PROJECT=syllabus-gap-audit
LANGSMITH_ENDPOINT=https://api.smith.langchain.com